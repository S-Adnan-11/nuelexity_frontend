# These four settings are exposed to the browser. Use the same Supabase project as the API.
BUN_PUBLIC_SUPABASE_URL=
BUN_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
BUN_PUBLIC_BACKEND_URL=http://localhost:3002
# Required to use production guest search.
BUN_PUBLIC_TURNSTILE_SITE_KEY=
# Port for the local server.
PORT=3000
