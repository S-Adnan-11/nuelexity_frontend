{
  "name": "nuelexity-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.0 <13"
  },
  "scripts": {
    "dev": "node --import ./scripts/env.mjs --import tsx scripts/dev.ts",
    "build": "node --import ./scripts/production-env.mjs --import tsx build.ts",
    "start": "node src/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "tsx scripts/check-model-ui.ts && tsx scripts/check-research-ui.ts && tsx scripts/check-milestone-ui.ts && tsx scripts/check-production-pages.ts && npm run test:startup-ui && npm run test:startup",
    "check": "npm run typecheck && npm test && npm run build",
    "env:init": "node scripts/init-env.mjs",
    "release:check": "node scripts/release-check.mjs",
    "preview:local": "node src/server.mjs --local-preview",
    "test:startup": "node scripts/check-brand-serving.mjs",
    "test:startup-ui": "tsx scripts/check-startup-ui.ts",
    "test:about": "tsx scripts/check-about-ui.ts",
    "build:pages": "node scripts/pages-build.mjs",
    "pages:prepare": "node scripts/pages-build.mjs --review",
    "test:pages": "tsx scripts/check-pages-ui.ts",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.117.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "@opentelemetry/api": "1.9.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "@tailwindcss/vite": "4.3.3",
    "vite": "7.3.7",
    "@types/express": "5.0.6"
  },
  "allowScripts": {
    "esbuild": true
  }
}
